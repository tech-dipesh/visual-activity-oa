generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  previewFeatures= ["postgresqlExtensions"]
  }

datasource db {
  provider = "postgresql"
  extensions = [pgcrypto]
}

enum EventType {
  VISIT
  CLICK
  SCROLL
}

model ActivityEvent {
  id          String    @id @default(cuid())
  type        EventType
  url         String
  tabId       Int
  elementInfo String?
  scrollDepth Int?
  occurredAt  DateTime
  createdAt   DateTime  @default(now())
}
