{
  "manifest_version": 3,
  "name": "Visual Activity Agent",
  "version": "1.0.0",
  "description": "Watches page visits, clicks and scrolling, then saves them to a database.",
  "permissions": ["tabs", "webNavigation"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content-script.js"],
      "run_at": "document_idle"
    }
  ]
}
